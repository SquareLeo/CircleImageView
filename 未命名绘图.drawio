        <mxCell id="sMwxe-QqFis0CnT4EMSm-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;我的订阅接口&lt;/h1&gt;&lt;div&gt;&lt;div&gt;GET https://subscription-api.jin10.com/tagList HTTP/1.1&lt;/div&gt;&lt;div&gt;User-Agent: Jin10 Android Client(v 6.29.0)&lt;/div&gt;&lt;div&gt;x-version: 1.0.0&lt;/div&gt;&lt;div&gt;x-app-id: g93rhHb9DcDptyPb&lt;/div&gt;&lt;div&gt;x-udid: 41b4ca002c53464b9c16da2cabbef2a0&lt;/div&gt;&lt;div&gt;x-token: e69c8b9f-3b91-43c3-b945-097ed0994961&lt;/div&gt;&lt;div&gt;x-app-ver: android_base_6.29.0.950&lt;/div&gt;&lt;div&gt;Host: subscription-api.jin10.com&lt;/div&gt;&lt;div&gt;Connection: Keep-Alive&lt;/div&gt;&lt;div&gt;Accept-Encoding: gzip&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;status&quot;: 200,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;message&quot;: &quot;OK&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &quot;data&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;push&quot;: 1,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;tagId&quot;: 854&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;push&quot;: 0,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;tagId&quot;: 1394&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;push&quot;: 1,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;tagId&quot;: 1395&lt;/div&gt;&lt;div&gt;&amp